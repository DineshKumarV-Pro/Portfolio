# Production environment variables
# Copy to .env.local and fill in before deploying.

# Canonical site URL (required for SEO, sitemap, OG tags, RSS)
VITE_SITE_URL=https://your-domain.com

# Analytics — disabled by default
VITE_ANALYTICS_ENABLED=false
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_PLAUSIBLE_DOMAIN=your-domain.com

# Newsletter provider — empty = stub mode (UI only)
# VITE_NEWSLETTER_PROVIDER=buttondown

# Future API integration
# VITE_CONTACT_API_URL=
# VITE_NEWSLETTER_API_URL=
# VITE_POSTHOG_KEY=
# VITE_CLARITY_ID=
# VITE_LINKEDIN_PARTNER_ID=
